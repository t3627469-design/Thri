    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": "1.21.11",
    "meteor-client": "*",
    "fabricloader": ">=0.18.2"
  }
}
