{
  "schemaVersion": 1,
  "id": "theone-client",
  "version": "2.0.1",
  "name": "TheOne Client",
  "description": "Schematic Builder for Meteor: builds .litematic/.schem/.nbt schematics with orientation-aware placing, auto walking, pillaring up, farmland and water.",
  "authors": [
    "TheOne"
  ],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.theone.schematic.TheOneAddon"
    ]
  },
  "custom": {
